{
  "annotations": {"list": []},
  "editable": false,
  "id": null,
  "panels": [
    {"id":1,"type":"stat","title":"Ready nodes","gridPos":{"h":5,"w":6,"x":0,"y":0},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})","instant":true}]},
    {"id":2,"type":"stat","title":"Running pods","gridPos":{"h":5,"w":6,"x":6,"y":0},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(kube_pod_status_phase{phase=\"Running\",namespace=~\"$namespace\"})","instant":true}]},
    {"id":3,"type":"stat","title":"Non-running pods","gridPos":{"h":5,"w":6,"x":12,"y":0},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(kube_pod_status_phase{phase!=\"Running\",phase!=\"Succeeded\",namespace=~\"$namespace\"})","instant":true}]},
    {"id":4,"type":"stat","title":"Healthy scrape targets","gridPos":{"h":5,"w":6,"x":18,"y":0},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(up)","instant":true}]},
    {"id":5,"type":"timeseries","title":"Cluster CPU usage","gridPos":{"h":8,"w":12,"x":0,"y":5},"fieldConfig":{"defaults":{"unit":"cores"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (exported_namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",pod!=\"\",container!=\"\",container!=\"POD\",image!=\"\",exported_namespace=~\"$namespace\"}[$__rate_interval]))","legendFormat":"{{exported_namespace}} / {{pod}}"}]},
    {"id":6,"type":"timeseries","title":"Cluster memory working set","gridPos":{"h":8,"w":12,"x":12,"y":5},"fieldConfig":{"defaults":{"unit":"bytesIEC"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (exported_namespace, pod) (container_memory_working_set_bytes{job=\"kubelet\",pod!=\"\",container!=\"\",container!=\"POD\",image!=\"\",exported_namespace=~\"$namespace\"})","legendFormat":"{{exported_namespace}} / {{pod}}"}]},
    {"id":7,"type":"timeseries","title":"Pod restarts by namespace","gridPos":{"h":8,"w":12,"x":0,"y":13},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (namespace) (kube_pod_container_status_restarts_total{namespace=~\"$namespace\"})","legendFormat":"{{namespace}}"}]},
    {"id":8,"type":"timeseries","title":"Scrape target health","gridPos":{"h":8,"w":12,"x":12,"y":13},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"count by (job) (up)","legendFormat":"{{job}}"}]},
    {"id":9,"type":"timeseries","title":"Node CPU usage","gridPos":{"h":8,"w":12,"x":0,"y":21},"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"(100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"prometheus-node-exporter\",mode=\"idle\"}[$__rate_interval]))) * on(instance) group_left(nodename) max by (instance, nodename) (node_uname_info{job=\"prometheus-node-exporter\"}))","legendFormat":"{{nodename}}"}]},
    {"id":10,"type":"timeseries","title":"Node memory usage","gridPos":{"h":8,"w":12,"x":12,"y":21},"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"(100 * (1 - max by (instance) (node_memory_MemAvailable_bytes{job=\"prometheus-node-exporter\"}) / max by (instance) (node_memory_MemTotal_bytes{job=\"prometheus-node-exporter\"})) * on(instance) group_left(nodename) max by (instance, nodename) (node_uname_info{job=\"prometheus-node-exporter\"}))","legendFormat":"{{nodename}}"}]}
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {"list": [{"name":"namespace","label":"Namespace","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"multi":true,"includeAll":true,"allValue":".*","query":"label_values(kube_pod_info, namespace)","current":{"text":"All","value":["$__all"]}}]},
